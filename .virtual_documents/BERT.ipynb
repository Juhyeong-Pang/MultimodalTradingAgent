class TransformerBlock(Layer):
    def __init__(self, embed_dim, num_heads, ff_dim, rate=0.1):
        super(TransformerBlock, self).__init__()
        self.att = MultiHeadAttention(num_heads=num_heads, key_dim=embed_dim // num_heads)
        self.ffn = tf.keras.Sequential([
            Dense(ff_dim, activation="relu"),
            Dense(embed_dim)
        ])
        self.layernorm1 = LayerNormalization(epsilon=1e-6)
        self.layernorm2 = LayerNormalization(epsilon=1e-6)
        self.dropout1 = Dropout(rate)
        self.dropout2 = Dropout(rate)

    def call(self, inputs, training=False):
        attn_output = self.att(query=inputs, value=inputs, key=inputs) 
        attn_output = self.dropout1(attn_output, training=training)
        out1 = self.layernorm1(inputs + attn_output)
        ff_output = self.ffn(out1)
        ff_output = self.dropout2(ff_output, training=training)
        return self.layernorm2(out1 + ff_output)


class TransformerEncoder(Layer):
    def __init__(self, num_layers, embed_dim, num_heads, ff_dim, rate = 0.1):
        super(TransformerEncoder, self).__init__()
        self.num_layers = num_layers
        self.embed_dim = embed_dim
        self.enc_layers = [TransformerBlock(embed_dim, num_heads, ff_dim, rate) for _ in range(num_layers)]
        self.drop_out = Dropout(rate)

    def call(self, inputs, training = False):
        x = inputs
        for i in range(self.num_layers):
            x = self.enc_layers[i](x, training= training)
        return x


sentiment_raw = pd.read_csv(os.path.join("sentiment_dataset", "all-data.csv"), encoding='latin1', header = None)
sentiment_raw.columns = ["Output", "Input"]
sentiment_dataset = sentiment_raw[["Input", "Output"]]


X, y = sentiment_dataset['Input'], sentiment_dataset['Output']


le = LabelEncoder()
y_encoded = le.fit_transform(y)

tokenizer = Tokenizer(num_words=20000, oov_token="<OOV>")
tokenizer.fit_on_texts(X)
sequences = tokenizer.texts_to_sequences(X)
X_seq = pad_sequences(sequences, maxlen=50, padding="post")


X_train, X_test, y_train, y_test = train_test_split(
    X_seq, y_encoded, test_size=0.2, random_state=42
)

X_train, X_val, y_train, y_val = train_test_split(
    X_train, y_train, test_size=0.2, random_state=42
)


X_seq.shape


max_len = 50
vocab_size = 20000

num_layers = 2
embed_dim = 128
num_heads = 8
ff_dim = 256

input_layer = Input(shape=(max_len,))
x = Embedding(input_dim=vocab_size, output_dim=embed_dim)(input_layer)
x = TransformerEncoder(num_layers, embed_dim, num_heads, ff_dim)(x)
x = GlobalAveragePooling1D()(x)
x = Dropout(0.2)(x)
x = Dense(64, activation="relu")(x)
output_layer = Dense(3, activation="softmax")(x)

model = Model(inputs = input_layer, outputs = output_layer)


model.compile(optimizer = "adam", loss = "sparse_categorical_crossentropy", metrics=["accuracy"])


progress_callback = LambdaCallback(
    on_batch_end=lambda batch, logs: print(f"\rBatch {batch} done. Loss: {logs['loss']:.4f}", end="")
)


history = model.fit(
    X_train,
    y_train,
    validation_data=(X_val, y_val),
    epochs=20,
    batch_size=128,
    verbose=1,
    callbacks=[progress_callback]
)


model.save_weights("bert_weights.weights.h5")


model.evaluate(X_test, y_test)


def predict(text):
    seq = tokenizer.texts_to_sequences(text)
    padded = pad_sequences(seq, maxlen=50, padding="post")
    
    pred = model.predict(padded)
    pred_class = pred.argmax(axis=1)
    
    sentiment = le.inverse_transform(pred_class)
    return sentiment


new_texts = ["Stocks rally after Fed announcement"]

print(predict(new_texts))















